<!doctype html>
<html lang="{{ t.lang }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex">
<title>{{ spec.business_name }}</title>
<style>
  :root { --accent: {{ spec.accent }}; --ink:#0f172a; --muted:#5b6474; --line:#e5e7eb; --soft:#f5f7fb; --dark:#0b1220; }
  * { box-sizing:border-box; }
  html { scroll-behavior:smooth; }
  body { margin:0; font-family:"Inter","Segoe UI",system-ui,-apple-system,Roboto,Arial,sans-serif; color:var(--ink); background:#fff; line-height:1.6; -webkit-font-smoothing:antialiased; }
  a { color:inherit; }
  .wrap { max-width:1120px; margin:0 auto; padding:0 22px; }
  .notice { background:#fff8e1; color:#6b5300; font-size:12.5px; text-align:center; padding:6px 12px; border-bottom:1px solid #f3e3a6; }
  .topbar { background:var(--dark); color:#cbd5e1; font-size:13px; }
  .topbar .wrap { display:flex; flex-wrap:wrap; gap:6px 22px; padding-top:8px; padding-bottom:8px; }
  .topbar span { display:inline-flex; align-items:center; gap:6px; }
  .topbar svg { width:14px; height:14px; }

  header.nav { position:sticky; top:0; z-index:5; background:rgba(255,255,255,.96); border-bottom:1px solid var(--line); backdrop-filter:saturate(1.4) blur(6px); }
  header.nav .wrap { display:flex; align-items:center; justify-content:space-between; gap:16px; height:68px; }
  .brand { display:flex; align-items:center; gap:10px; font-weight:800; font-size:19px; letter-spacing:-.01em; text-decoration:none; }
  .badge { width:38px; height:38px; border-radius:10px; background:var(--accent); color:#fff; display:grid; place-items:center; font-size:15px; font-weight:800; }
  nav.links { display:flex; gap:24px; font-size:15px; color:var(--muted); }
  nav.links a { text-decoration:none; }
  nav.links a:hover { color:var(--ink); }
  .btn { display:inline-flex; align-items:center; gap:8px; padding:12px 20px; border-radius:10px; font-weight:650; font-size:15px; text-decoration:none; border:1px solid transparent; cursor:pointer; }
  .btn svg { width:18px; height:18px; }
  .btn-primary { background:var(--accent); color:#fff; }
  .btn-light { background:#fff; color:var(--ink); }
  .btn-ghost { border-color:rgba(255,255,255,.35); color:#fff; }
  .btn-outline { border-color:var(--line); color:var(--ink); background:#fff; }

  .hero { background:radial-gradient(1200px 500px at 85% -10%, color-mix(in srgb, var(--accent) 55%, transparent), transparent), linear-gradient(160deg, #0b1220 0%, #111a2e 100%); color:#fff; overflow:hidden; }
  .hero .wrap { display:grid; grid-template-columns:1.15fr .85fr; gap:40px; align-items:center; padding-top:76px; padding-bottom:84px; }
  .eyebrow { display:inline-block; font-size:13px; font-weight:600; letter-spacing:.02em; padding:6px 12px; border-radius:999px; background:rgba(255,255,255,.1); border:1px solid rgba(255,255,255,.18); color:#e2e8f0; margin-bottom:18px; }
  .hero h1 { font-size:clamp(34px,5.2vw,56px); line-height:1.07; letter-spacing:-.025em; margin:0 0 18px; }
  .hero p.lead { font-size:18.5px; color:#cbd5e1; max-width:560px; margin:0 0 30px; }
  .actions { display:flex; flex-wrap:wrap; gap:12px; }

  .device { justify-self:center; width:260px; height:520px; border-radius:42px; background:#0a0f1a; padding:12px; box-shadow:0 40px 80px rgba(0,0,0,.45), inset 0 0 0 2px #253049; position:relative; }
  .device::before { content:""; position:absolute; top:22px; left:50%; transform:translateX(-50%); width:84px; height:22px; border-radius:12px; background:#0a0f1a; z-index:2; }
  .screen { height:100%; border-radius:32px; background:#f8fafc; overflow:hidden; color:var(--ink); }
  .screen .bar { background:var(--accent); color:#fff; padding:46px 18px 18px; }
  .screen .bar b { display:block; font-size:16px; }
  .screen .bar small { opacity:.85; font-size:12px; }
  .screen .body { padding:16px; display:grid; gap:10px; }
  .chip { background:#fff; border:1px solid var(--line); border-radius:12px; padding:10px 12px; font-size:13px; display:flex; align-items:center; gap:10px; }
  .chip svg { width:18px; height:18px; color:var(--accent); flex:none; }
  .ok { background:color-mix(in srgb, var(--accent) 10%, #fff); border-color:color-mix(in srgb, var(--accent) 35%, #fff); font-weight:600; }

  section { padding:84px 0; }
  .alt { background:var(--soft); }
  .kicker { color:var(--accent); font-weight:700; font-size:13px; letter-spacing:.08em; text-transform:uppercase; margin:0 0 8px; }
  h2 { font-size:clamp(28px,3.4vw,38px); letter-spacing:-.02em; line-height:1.15; margin:0 0 14px; }
  .sub { color:var(--muted); font-size:17px; max-width:640px; margin:0 0 40px; }

  .strip { padding:0; margin-top:-38px; position:relative; }
  .strip .grid3 { display:grid; grid-template-columns:repeat(3,1fr); gap:18px; }
  .feature { background:#fff; border:1px solid var(--line); border-radius:16px; padding:22px; box-shadow:0 12px 30px rgba(15,23,42,.06); display:flex; gap:14px; }
  .feature .ic { width:44px; height:44px; border-radius:12px; display:grid; place-items:center; background:color-mix(in srgb, var(--accent) 12%, #fff); color:var(--accent); flex:none; }
  .feature .ic svg, .card .ic svg { width:22px; height:22px; }
  .feature h3 { margin:0 0 4px; font-size:16.5px; }
  .feature p { margin:0; color:var(--muted); font-size:14.5px; }

  .grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(240px,1fr)); gap:18px; }
  .card { background:#fff; border:1px solid var(--line); border-radius:16px; padding:26px; transition:transform .15s, box-shadow .15s; }
  .card:hover { transform:translateY(-3px); box-shadow:0 16px 36px rgba(15,23,42,.08); }
  .card .ic { width:48px; height:48px; border-radius:12px; display:grid; place-items:center; background:var(--accent); color:#fff; margin-bottom:16px; }
  .card h3 { margin:0 0 6px; font-size:18px; }
  .card p { margin:0; color:var(--muted); font-size:15px; }
  .note { margin-top:18px; font-size:13px; color:var(--muted); font-style:italic; }

  .two { display:grid; grid-template-columns:1.1fr .9fr; gap:44px; align-items:start; }
  .about-text { font-size:17px; color:#334155; }
  .info { background:#fff; border:1px solid var(--line); border-radius:16px; padding:8px 22px; }
  .info .row { display:flex; gap:14px; padding:16px 0; border-bottom:1px solid var(--line); }
  .info .row:last-child { border-bottom:0; }
  .info svg { width:20px; height:20px; color:var(--accent); flex:none; margin-top:3px; }
  .info .label { display:block; font-size:12px; text-transform:uppercase; letter-spacing:.06em; color:var(--muted); }
  .info .val { overflow-wrap:anywhere; font-weight:500; }

  form.booking { background:#fff; border:1px solid var(--line); border-radius:18px; padding:26px; box-shadow:0 16px 40px rgba(15,23,42,.07); display:grid; gap:14px; }
  .field label { display:block; font-size:13px; font-weight:600; margin-bottom:6px; }
  .field input, .field select, .field textarea { width:100%; font:inherit; font-size:15px; padding:11px 12px; border:1px solid #d6dae1; border-radius:10px; background:#fff; color:var(--ink); }
  .pair { display:grid; grid-template-columns:1fr 1fr; gap:14px; }
  .formnote { font-size:12.5px; color:var(--muted); text-align:center; margin:0; }

  .map { border-radius:18px; overflow:hidden; border:1px solid var(--line); height:380px; background:var(--soft); }
  .map iframe { width:100%; height:100%; border:0; }

  footer { background:var(--dark); color:#94a3b8; padding:34px 0; font-size:14px; }
  footer .wrap { display:flex; flex-wrap:wrap; justify-content:space-between; gap:12px; }
  footer b { color:#fff; }

  .wa { position:fixed; right:20px; bottom:20px; width:58px; height:58px; border-radius:50%; background:#25d366; color:#fff; display:grid; place-items:center; box-shadow:0 10px 26px rgba(0,0,0,.25); z-index:10; }
  .wa svg { width:30px; height:30px; }

  @media (max-width: 860px) {
    .hero .wrap, .two { grid-template-columns:1fr; }
    .device { display:none; }
    nav.links { display:none; }
    .strip .grid3 { grid-template-columns:1fr; }
    .pair { grid-template-columns:1fr; }
    section { padding:64px 0; }
  }
</style>
</head>
<body>
<div class="notice">{{ t.notice }}{% if spec.prepared_by %} {{ t.prepared_by }} {{ spec.prepared_by }}.{% endif %}</div>

{% if spec.address or spec.phone or spec.opening_hours %}
<div class="topbar"><div class="wrap">
  {% if spec.address %}<span>{{ icon('pin') }}{{ spec.address }}</span>{% endif %}
  {% if spec.opening_hours %}<span>{{ icon('clock') }}{{ spec.opening_hours }}</span>{% endif %}
  {% if spec.phone %}<span>{{ icon('phone') }}{{ spec.phone }}</span>{% endif %}
</div></div>
{% endif %}

<header class="nav"><div class="wrap">
  <a class="brand" href="#top"><span class="badge">{{ initials }}</span>{{ spec.business_name }}</a>
  <nav class="links">
    <a href="#services">{{ t.services }}</a>
    <a href="#about">{{ t.about }}</a>
    {% if spec.booking_title %}<a href="#booking">{{ spec.booking_title }}</a>{% endif %}
    <a href="#contact">{{ t.contact }}</a>
  </nav>
  {% if spec.phone %}<a class="btn btn-primary" href="tel:{{ tel }}">{{ icon('phone') }}{{ t.call }}</a>
  {% else %}<a class="btn btn-primary" href="#contact">{{ spec.cta_text }}</a>{% endif %}
</div></header>

<div class="hero" id="top"><div class="wrap">
  <div>
    {% if spec.eyebrow %}<span class="eyebrow">{{ spec.eyebrow }}</span>{% endif %}
    <h1>{{ spec.tagline }}</h1>
    <p class="lead">{{ spec.hero_text }}</p>
    <div class="actions">
      <a class="btn btn-light" href="{% if spec.booking_title %}#booking{% else %}#contact{% endif %}">{{ spec.cta_text }}</a>
      {% if spec.whatsapp %}<a class="btn btn-ghost" href="https://wa.me/{{ spec.whatsapp }}" target="_blank" rel="noopener">{{ icon('chat') }}{{ t.whatsapp }}</a>
      {% elif spec.phone %}<a class="btn btn-ghost" href="tel:{{ tel }}">{{ icon('phone') }}{{ t.call }}</a>{% endif %}
    </div>
  </div>
  <div class="device" aria-hidden="true"><div class="screen">
    <div class="bar"><b>{{ spec.business_name }}</b><small>{{ spec.eyebrow }}</small></div>
    <div class="body">
      {% if spec.booking_title %}<div class="chip ok">{{ icon('check') }}{{ spec.booking_title }}</div>{% endif %}
      {% for s in spec.services[:4] %}<div class="chip">{{ icon(service_icon(s.name)) }}{{ s.name }}</div>{% endfor %}
      {% if spec.opening_hours %}<div class="chip">{{ icon('clock') }}{{ spec.opening_hours }}</div>{% endif %}
    </div>
  </div></div>
</div></div>

{% if spec.highlights %}
<div class="strip"><div class="wrap"><div class="grid3">
  {% for h in spec.highlights[:3] %}
  <div class="feature"><div class="ic">{{ icon(['calendar', 'pin', 'chat'][loop.index0]) }}</div>
    <div><h3>{{ h.name }}</h3>{% if h.description %}<p>{{ h.description }}</p>{% endif %}</div></div>
  {% endfor %}
</div></div></div>
{% endif %}

{% if spec.services %}
<section id="services"><div class="wrap">
  <p class="kicker">{{ t.services }}</p>
  <h2>{{ spec.business_name }}</h2>
  <div class="grid">
    {% for s in spec.services %}
    <div class="card"><div class="ic">{{ icon(service_icon(s.name)) }}</div><h3>{{ s.name }}</h3>{% if s.description %}<p>{{ s.description }}</p>{% endif %}</div>
    {% endfor %}
  </div>
  {% if spec.services | selectattr('example') | list %}<p class="note">{{ t.example_note }}</p>{% endif %}
</div></section>
{% endif %}

<section id="about" class="alt"><div class="wrap two">
  <div>
    <p class="kicker">{{ t.about }}</p>
    <h2>{{ spec.business_name }}</h2>
    <p class="about-text">{{ spec.about }}</p>
  </div>
  <div class="info">
    {% if spec.address %}<div class="row">{{ icon('pin') }}<div><span class="label">{{ t.address }}</span><span class="val">{{ spec.address }}</span></div></div>{% endif %}
    {% if spec.opening_hours %}<div class="row">{{ icon('clock') }}<div><span class="label">{{ t.hours }}</span><span class="val">{{ spec.opening_hours }}</span></div></div>{% endif %}
    {% if spec.phone %}<div class="row">{{ icon('phone') }}<div><span class="label">{{ t.phone }}</span><span class="val">{{ spec.phone }}</span></div></div>{% endif %}
    {% if spec.email %}<div class="row">{{ icon('mail') }}<div><span class="label">{{ t.email }}</span><span class="val">{{ spec.email }}</span></div></div>{% endif %}
    {% if not (spec.address or spec.phone or spec.email or spec.opening_hours) %}<div class="row"><div class="val">{{ t.contact_pending }}</div></div>{% endif %}
  </div>
</div></section>

{% if spec.booking_title %}
<section id="booking"><div class="wrap two">
  <div>
    <p class="kicker">{{ spec.booking_title }}</p>
    <h2>{{ spec.booking_title }}</h2>
    <p class="sub">{{ spec.booking_text }}</p>
  </div>
  <form class="booking" onsubmit="return false">
    <div class="pair">
      <div class="field"><label>{{ t.your_name }}</label><input type="text" autocomplete="off"></div>
      <div class="field"><label>{{ t.your_phone }}</label><input type="tel" autocomplete="off"></div>
    </div>
    <div class="pair">
      <div class="field"><label>{{ t.service }}</label><select>{% for s in spec.services %}<option>{{ s.name }}</option>{% endfor %}</select></div>
      <div class="field"><label>{{ t.date }}</label><input type="date"></div>
    </div>
    <div class="field"><label>{{ t.message }}</label><textarea rows="3"></textarea></div>
    <button class="btn btn-primary" type="button">{{ t.send }}</button>
    <p class="formnote">{{ t.demo_form }}</p>
  </form>
</div></section>
{% endif %}

<section id="contact" class="alt"><div class="wrap">
  <p class="kicker">{{ t.contact }}</p>
  <h2>{{ t.find_us }}</h2>
  {% if map_src %}<div class="map"><iframe src="{{ map_src }}" loading="lazy" title="{{ t.find_us }}"></iframe></div>{% endif %}
  <div class="actions" style="margin-top:22px">
    {% if directions %}<a class="btn btn-outline" href="{{ directions }}" target="_blank" rel="noopener">{{ icon('pin') }}{{ t.directions }}</a>{% endif %}
    {% if spec.phone %}<a class="btn btn-primary" href="tel:{{ tel }}">{{ icon('phone') }}{{ t.call }}</a>{% endif %}
    {% if spec.email %}<a class="btn btn-outline" href="mailto:{{ spec.email }}">{{ icon('mail') }}{{ spec.email }}</a>{% endif %}
  </div>
  {% if not (spec.address or spec.phone or spec.email) %}<p class="sub" style="margin-top:16px">{{ t.contact_pending }}</p>{% endif %}
</div></section>

<footer><div class="wrap">
  <span><b>{{ spec.business_name }}</b>{% if spec.address %} · {{ spec.address }}{% endif %}</span>
  <span>{{ t.footer }}</span>
</div></footer>

{% if spec.whatsapp %}<a class="wa" href="https://wa.me/{{ spec.whatsapp }}" target="_blank" rel="noopener" aria-label="WhatsApp">{{ icon('whatsapp') }}</a>{% endif %}
</body>
</html>
