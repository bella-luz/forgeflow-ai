# Copy this file to .env and fill in the values. Never commit .env.
# Every key is optional: without keys the app runs in demo mode with preview-only email.

# LLM (free tier): https://console.groq.com
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# Web research (free tier): https://tavily.com
TAVILY_API_KEY=

# Email over SMTP. Brevo free plan: smtp-relay.brevo.com, port 587.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Public address of the deployed app, used to build demo links.
APP_BASE_URL=http://localhost:8501
